# Kaggle-mounted inputs. Leave model unset to use safe auto-discovery.
KAGGLE_INPUT_ROOT=/kaggle/input
# KAGGLE_MODEL_DIR=/kaggle/input/models/dangkhoa2016/qwen-qwen3-embedding-8b/transformers/default/1
# KAGGLE_DATASET_DIR=/kaggle/input/wikidata-en-vi-semantic-search-100k

WORKING_DIR=/kaggle/working/qwen3-embedding-8b-t4x2
WORKER_COUNT=2
EMBEDDING_DIMENSIONS=4096
MAX_BATCH_ITEMS=16
MAX_BATCH_ESTIMATED_TOKENS=512
MAX_QUEUE_ESTIMATED_TOKENS=32768
MAX_REQUEST_ITEMS=128
MAX_REQUEST_BODY_BYTES=2000000
MAX_TEXT_CHARACTERS=32768
MAX_SEQUENCE_TOKENS=4096
# SEARCH_INDEX_DIR=/kaggle/working/qwen3-embedding-8b-t4x2/index
EXPOSE_MODE=off
